# syntax=docker/dockerfile:1

FROM cgr.dev/chainguard/wolfi-base AS os
ARG TARGETARCH

RUN apk add --no-cache apko

# Same content as the chisel and fedora variants: base layout + glibc.
# glibc pulls in ld-linux and libgcc, wolfi-baselayout pulls in ca-certificates-bundle.
COPY <<EOF /work/apko.yaml
contents:
  repositories:
    - https://packages.wolfi.dev/os
  keyring:
    - https://packages.wolfi.dev/os/wolfi-signing.rsa.pub
  packages:
    - wolfi-baselayout
    - glibc
accounts:
  groups:
    - groupname: nonroot
      gid: 65532
  users:
    - username: nonroot
      uid: 65532
      gid: 65532
EOF

# Build the root filesystem as a tarball (plus an SBOM) and unpack it for the final stage.
# The output is a plain, uncompressed tar.
RUN apko build-minirootfs \
        --build-arch "$TARGETARCH" \
        --sbom-path /work \
        /work/apko.yaml /work/rootfs.tar \
    && mkdir /staging-rootfs \
    && tar -xf /work/rootfs.tar -C /staging-rootfs

FROM eclipse-temurin:25-jdk-noble  AS builder
WORKDIR /builder
# This points to the built jar file in the target folder
# Adjust this to 'build/libs/*.jar' if you're using Gradle
ARG JAR_FILE=target/*.jar
# Copy the jar file to the working directory and rename it to application.jar
COPY ${JAR_FILE} application.jar
# Extract the jar file using an efficient layout
RUN java -Djarmode=tools -jar application.jar extract --layers --destination extracted

RUN jdeps --ignore-missing-deps -q  \
    --recursive  \
    --print-module-deps  \
    --multi-release 25 \
    --class-path 'extracted/dependencies/lib/*'  \
    extracted/application/*.jar > deps.info
RUN cat deps.info
RUN jlink \
    --add-modules $(cat deps.info) \
    --strip-debug \
    --compress zip-9 \
    --no-header-files \
    --no-man-pages \
    --output /myjre

# This is the runtime container
FROM scratch
COPY --from=os /staging-rootfs /

ENV JAVA_HOME=/opt/java
ENV PATH=$JAVA_HOME/bin:$PATH
COPY --from=builder /myjre $JAVA_HOME

WORKDIR /application
# Copy the extracted jar contents from the builder container into the working directory in the runtime container
# Every copy step creates a new docker layer
# This allows docker to only pull the changes it really needs
COPY --from=builder /builder/extracted/dependencies/ ./
COPY --from=builder /builder/extracted/spring-boot-loader/ ./
COPY --from=builder /builder/extracted/snapshot-dependencies/ ./
COPY --from=builder /builder/extracted/application/ ./
# Start the application jar - this is not the uber jar used by the builder
# This jar only contains application code and references to the extracted jar files
# This layout is efficient to start up and CDS/AOT cache friendly
ENTRYPOINT ["java", "-jar", "application.jar"]
