{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.16.0/.schema/devbox.schema.json",
  "packages": [
    "zulu@25.0.3",
    "httpie@latest"
  ],
  "shell": {
    "init_hook": [
      "echo 'Welcome to devbox!' > /dev/null"
    ],
    "scripts": {
      "analyze": [
        "rm -rf ext && rm -f loose-*.jar && rm -f result.csv",
        "docker compose up -d --wait",
        "http --download --output loosejar-1.2.0.jar https://github.com/kyrill007/loosejar/releases/download/v1.2.0/loosejar-1.2.0.jar",
        "./mvnw clean verify",
        "java -Djarmode=tools -jar target/movie-service-0.0.1-SNAPSHOT.jar extract --destination ext",
        "java -jar -javaagent:./loosejar-1.2.0.jar -Dloosejar.outputFile=result.csv -Dloosejar.format=csv ext/movie-service-0.0.1-SNAPSHOT.jar &",
        "until nc -z localhost 8080; do sleep 1; done",
        "http POST :8080/api/movies name=Sinners releaseDate=2025-04-18 category=Horror",
        "PID=$(jps -l | awk '/movie-service-0.0.1-SNAPSHOT.jar/ {print $1}')",
        "kill $PID",
        "while kill -0 $PID 2>/dev/null; do sleep 1; done",
        "grep '\"0,00%\"' result.csv > result.csv.tmp; mv result.csv.tmp result.csv",
        "docker compose down --volumes"
      ],
      "build": [
        "./mvnw clean verify",
        "docker build -f src/main/docker/Dockerfile -t movie-service:latest ."
      ],
      "build-optimized": [
        "./mvnw clean verify -Poptimized",
        "docker build -f src/main/docker/Dockerfile -t movie-service:optimized ."
      ],
      "build-ownjre": [
        "./mvnw clean verify -Poptimized",
        "docker build -f src/main/docker/Dockerfile.ownjre -t movie-service:ownjre ."
      ],
      "build-chisel": [
        "./mvnw clean verify -Poptimized",
        "docker build -f src/main/docker/Dockerfile.chisel -t movie-service:chisel ."
      ],
      "build-fedora": [
        "./mvnw clean verify -Poptimized",
        "docker build -f src/main/docker/Dockerfile.fedora -t movie-service:fedora ."
      ],
      "build-debian": [
        "./mvnw clean verify -Poptimized",
        "docker build -f src/main/docker/Dockerfile.debian -t movie-service:debian ."
      ]
    }
  }
}
